OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash
JWT_SECRET=generate-with-openssl-rand-hex-32
ENABLE_REGISTRATION=true

# CORS origin for the frontend (defaults to the production domain)
ALLOWED_ORIGIN=https://translate.dengshu.ovh

# Umami Analytics (leave empty to disable tracking)
UMAMI_WEBSITE_ID=
